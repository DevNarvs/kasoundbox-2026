# Week-1 spike (test project only, D-28). Names follow docs/05-technical/architecture.md §8. Never commit values.
# .env.local on your machine holds BOTH parts. Only part 1 goes on Vercel.

# --- Part 1: Vercel (Production; the build reads them too) ---------------------------------------------------
# The production alias (https://<project>.vercel.app or your test domain), never a per-deployment URL.
SITE_URL=
# app_rw.<project-ref> on the TRANSACTION pooler, port 6543, no sslmode.
DATABASE_URL=
# The Supabase CA certificate (PEM, several lines; in .env.local wrap it in double quotes).
SUPABASE_DB_CA=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 1: followed by `openssl rand -base64 32`.
BETTER_AUTH_SECRETS=
# Optional: the spike passes SITE_URL to Better Auth as its base URL.
BETTER_AUTH_URL=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
# The DIRECT host (db.<project-ref>.supabase.co:5432) with app_rw's user and password, never postgres's.
SPIKE_DIRECT_DATABASE_URL=
# Leave unset on Vercel (it then means https://api.resend.com); only for a local fake.
SPIKE_RESEND_URL=

# --- Part 2: your machine only (read by the probe scripts with --env-file); never on Vercel --------------------
# The same address as SITE_URL.
SPIKE_BASE_URL=
# postgres.<project-ref> on the SESSION pooler, port 5432. It holds the postgres password: laptop only.
SPIKE_SESSION_POOLER_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SPIKE_ADMIN_EMAIL=
SPIKE_ADMIN_PASSWORD=
SPIKE_TOTP_SECRET=
SPIKE_EMAIL_TO=
SPIKE_EMAIL_TO_2=
